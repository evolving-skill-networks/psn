# Copy this file to .env and fill in the values you need.
# PSN reads .env on every run; later in-process env vars override these.

# ============================================================
# LLM backend — pick ONE of the two paths below
# ============================================================

# Path A: OpenAI API (default)
OPENAI_API_KEY="<YOUR OPENAI API KEY>"
OPENAI_MODEL="gpt-5-mini"

# Path B: any OpenAI-compatible endpoint (vLLM, TGI, vLLM-on-Modal, etc.)
# When VLLM_API_BASE is set, all agents (planner / action / critic /
# curriculum / optimizer) default to this endpoint with VLLM_MODEL.
# VLLM_API_BASE="http://localhost:8000/v1"
# VLLM_API_KEY="EMPTY"                              # most local servers accept anything
# VLLM_MODEL="Qwen/Qwen3-Coder-Next-FP8"            # the diamond-pickaxe verified model

# ============================================================
# Optional — per-agent model / endpoint overrides
# ============================================================
# Each agent can be pointed at a different model or backend by setting
# {AGENT}_MODEL plus optionally {AGENT}_API_BASE + {AGENT}_API_KEY. The
# {AGENT} prefix is one of:
#   ACTION_AGENT, CRITIC_AGENT, CURRICULUM_AGENT, CURRICULUM_AGENT_QA,
#   SKILL_MANAGER
# Example: default everything to vLLM Qwen3-Coder above, but send only
# the critic to OpenAI gpt-5-mini for stronger task-success judgment:
#   CRITIC_AGENT_MODEL="gpt-5-mini"
#   CRITIC_AGENT_API_BASE=""                        # empty → use OpenAI default
#   CRITIC_AGENT_API_KEY="$OPENAI_API_KEY"
#
# Embeddings (used by knowledge retrieval + skill graph vector store)
# always go through OpenAI's default text-embedding endpoint and read
# OPENAI_API_KEY directly — no per-agent override.

# ============================================================
# Optional — bot replay recording
# ============================================================
# Set to an output filename to record every server packet the bot
# observes into a .mcpr file (replayable in any Minecraft client).
# Useful for debugging what the bot saw during a specific iteration.
# Recordings are written under <ckpt-dir>/recordings/{PSN_MCPR_OUTPUT}.
# PSN_MCPR_OUTPUT="bot_session"
