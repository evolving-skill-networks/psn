+// PATCH (skillnet): the block names a placement with this held item may
+// legitimately produce at the destination cell. Success used to be "any
+// block-type change at dest", so water or lava flowing in, or gravel
+// settling there, converted a server-rejected placement into a resolved
+// success with a fabricated blockPlaced event -- both evidence channels
+// lying at once. Unknown or non-placeable items return null and keep the
+// legacy any-change semantics (flint_and_steel must stay there: its dest
+// can convert to nether_portal in the same tick).
+function expectedBlockNames (itemName, registry) {
+  if (!itemName) return null
+  const specials = {
+    water_bucket: ['water'],
+    lava_bucket: ['lava'],
+    powder_snow_bucket: ['powder_snow'],
+    redstone: ['redstone_wire'],
+    string: ['tripwire'],
+    wheat_seeds: ['wheat'],
+    beetroot_seeds: ['beetroots'],
+    melon_seeds: ['melon_stem'],
+    pumpkin_seeds: ['pumpkin_stem'],
+    carrot: ['carrots'],
+    potato: ['potatoes'],
+    sweet_berries: ['sweet_berry_bush'],
+    glow_berries: ['cave_vines'],
+    cocoa_beans: ['cocoa'],
+    bamboo: ['bamboo', 'bamboo_sapling'],
+    torchflower_seeds: ['torchflower_crop']
+  }
+  const out = new Set(specials[itemName] || [])
+  if (registry.blocksByName[itemName]) out.add(itemName)
+  // wall variants: torch -> wall_torch, oak_sign -> oak_wall_sign, ...
+  const wall = itemName.replace(/([^_]+)$/, 'wall_$1')
+  if (registry.blocksByName[wall]) out.add(wall)
+  // hanging signs deviate from the wall rule: X_hanging_sign -> X_wall_hanging_sign
+  const hang = itemName.replace(/_hanging_sign$/, '_wall_hanging_sign')
+  if (hang !== itemName && registry.blocksByName[hang]) out.add(hang)
+  return out.size > 0 ? out : null
+}
