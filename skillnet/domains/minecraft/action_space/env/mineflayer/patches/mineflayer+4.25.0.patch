+// PATCH (skillnet, P4): Diagnose why a placeBlock silently failed (server
+// accepted-but-ignored OR genuinely rejected the packet with no blockUpdate
+// event). See Study 05 for the architectural rationale: primitives must
+// surface mechanistic state on failure instead of opaque timeouts.
+function _diagnosePlaceFailure (bot, refBlock, faceVector, dest) {
+  const parts = []
+  if (!bot.entity) return 'bot.entity undefined (died / disconnected)'
+  const pos = bot.entity.position
+  parts.push(`bot at (${pos.x.toFixed(2)},${pos.y.toFixed(2)},${pos.z.toFixed(2)})`)
+  // Is the destination cell inside the bot's bounding box? That makes the
+  // server silently reject the placement without sending any update.
+  const botXCell = Math.floor(pos.x)
+  const botZCell = Math.floor(pos.z)
+  const botFeetY = Math.floor(pos.y)
+  const botHeadY = Math.floor(pos.y + 1.8)
+  const destInBot = botXCell === dest.x && botZCell === dest.z &&
+                    dest.y >= botFeetY && dest.y <= botHeadY
+  if (destInBot) {
+    parts.push('DEST IS INSIDE BOT BOUNDING BOX (server silently rejects this)')
+  }
+  const actual = bot.blockAt(dest)
+  parts.push(`actual block at dest (${dest.x},${dest.y},${dest.z}): ${actual ? actual.name : 'null'}`)
+  if (refBlock) {
+    parts.push(`ref block: ${refBlock.name} at (${refBlock.position.x},${refBlock.position.y},${refBlock.position.z})`)
+  }
+  parts.push(`face: (${faceVector.x},${faceVector.y},${faceVector.z})`)
+  parts.push(`held: ${bot.heldItem ? bot.heldItem.name : 'empty'}`)
+  const conds = []
+  if (bot.entity.isInLava) conds.push('in_lava')
+  if (bot.entity.isInWater) conds.push('in_water')
+  if (!bot.entity.onGround) conds.push('airborne')
+  if (conds.length) parts.push(`bot state: ${conds.join(',')}`)
+  return parts.join('; ')
+}
