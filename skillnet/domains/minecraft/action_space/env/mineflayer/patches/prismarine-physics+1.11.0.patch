+      // PATCH (skillnet): sprint-swim. prismarine-physics never implemented the
+      // 1.13+ swimming speed boost / look-directional swim, so a bot in water is
+      // stuck at ~base speed and cannot swim down by aiming. When swimming
+      // (sprint + submerged) and giving movement input, add an impulse along the
+      // 3D look vector so the bot swims fast in the looked direction (incl. up /
+      // down). Tuned to ~vanilla sprint-swim speed. The server already treats it
+      // as swimming (from the sprint flag), so it accepts this without rubber-band.
+      if (entity.swimming && (Math.abs(forward) > 0.01 || Math.abs(strafe) > 0.01)) {
+        const sv = getLookingVector(entity)
+        const swimAccel = 0.045
+        vel.x += sv.lookX * swimAccel
+        vel.y += sv.lookY * swimAccel
+        vel.z += sv.lookZ * swimAccel
+      }
