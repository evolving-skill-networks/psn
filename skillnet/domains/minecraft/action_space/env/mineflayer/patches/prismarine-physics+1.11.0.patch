+      // Do NOT stand back up (1.8) inside a space too short for it: that would
+      // wedge the bot in the block and suffocate it. Stay in the swim pose until
+      // there is room to stand.
+      const _standBB = getPlayerBB(pos)
+      if (getSurroundingBBs(world, _standBB).some(b => _standBB.intersects(b))) _wantSwim = true
+    }
+    entity.swimming = _wantSwim
+    if (entity.swimming) physics.playerHeight = 0.6
+
     // Reset velocity component if it falls under the threshold
