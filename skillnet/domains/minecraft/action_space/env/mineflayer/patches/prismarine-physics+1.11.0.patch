+    // bot's own physics in step with the pose the server already renders from
+    // the sprint flag (mineflayer sends start_sprinting -> server setSwimming).
+    physics.playerHeight = 1.8
+
     const waterBB = getPlayerBB(pos).contract(0.001, 0.401, 0.001)
     const lavaBB = getPlayerBB(pos).contract(0.1, 0.4, 0.1)
 
