@@ -706,12 +720,33 @@ function Physics (mcData, world) {
     const vel = entity.vel
     const pos = entity.pos
 
+    // PATCH (skillnet): swimming pose hitbox. Each tick starts at the standing
+    // height so isInWater is decided with the normal box; below, when the bot is
+    // sprint-swimming, we shrink to the 0.6 swimming box for the rest of the
