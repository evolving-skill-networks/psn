--- a/mineflayer/lib/plugins/entities.js	1985-10-26 04:15:00.000000000 -0400
+++ b/mineflayer/lib/plugins/entities.js	2026-05-20 18:38:00.000000000 -0400
@@ -268,7 +268,17 @@
     entity.pitch = conv.fromNotchianPitchByte(packet.pitch)
     entity.headPitch = conv.fromNotchianPitchByte(packet.headPitch)
 
-    const notchVel = new Vec3(packet.velocityX, packet.velocityY, packet.velocityZ)
+    // PSN local patch: MC 1.19+ sends velocity as a nested object
+    // ({velocity: {x,y,z}}) instead of the flat velocityX/Y/Z fields the
+    // upstream handler was written against. The flat reads were resolving
+    // to `undefined`, `undefined * (1/8000)` is NaN, and NaN entered
+    // bot.entity.velocity via update() → next physics tick consumed NaN
+    // → bot.entity.position became NaN → MC kicked us with
+    // "Invalid move player packet received". Prefer the nested form,
+    // fall back to the legacy flat fields for older protocols.
+    const notchVel = packet.velocity
+      ? new Vec3(packet.velocity.x, packet.velocity.y, packet.velocity.z)
+      : new Vec3(packet.velocityX, packet.velocityY, packet.velocityZ)
     entity.velocity.update(conv.fromNotchVelocity(notchVel))
     entity.metadata = parseMetadata(packet.metadata, entity.metadata)
 
@@ -278,7 +288,11 @@
   bot._client.on('entity_velocity', (packet) => {
     // entity velocity
     const entity = fetchEntity(packet.entityId)
-    const notchVel = new Vec3(packet.velocityX, packet.velocityY, packet.velocityZ)
+    // PSN local patch: see spawn_entity_living above — MC 1.19+ uses
+    // packet.velocity = {x,y,z} not flat velocityX/Y/Z.
+    const notchVel = packet.velocity
+      ? new Vec3(packet.velocity.x, packet.velocity.y, packet.velocity.z)
+      : new Vec3(packet.velocityX, packet.velocityY, packet.velocityZ)
     entity.velocity.update(conv.fromNotchVelocity(notchVel))
   })
 
